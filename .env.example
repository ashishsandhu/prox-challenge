# ── LLM Providers ──────────────────────────────────────────────────────────
# Primary — Best reasoning & vision (Claude-optimized)
ANTHROPIC_API_KEY=

# Fallback 1 — Gemini (Reasoning, Vision & Transcription ready)
GOOGLE_API_KEY=

# Fallback 2 — Groq (Reasoning, Vision, & Whisper ready)
GROQ_API_KEY=

# ── TTS Providers (pick one or both, ElevenLabs tried first) ───────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

FISH_AUDIO_API_KEY=
# Optional: override the default FishAudio voice reference ID
FISH_AUDIO_VOICE_ID=

# ── Voice Transcription ───────────────────────────────────────────────────
# Most users don't need a separate key here. 
# The Groq and Google keys above already unlock high-performance transcription.
# OpenAI key is only needed as an optional legacy fallback.
OPENAI_API_KEY=
