# ── LLM Providers ──────────────────────────────────────────────────────────
# Primary — best results, required for vision features
ANTHROPIC_API_KEY=

# Fallback 1 — Gemini (vision capable)
GOOGLE_API_KEY=

# Fallback 2 — Groq (Llama 3.3 70B text, also used for Whisper transcription)
GROQ_API_KEY=

# ── TTS Providers (pick one or both, ElevenLabs tried first) ───────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

FISH_AUDIO_API_KEY=
# Optional: override the default FishAudio voice reference ID
FISH_AUDIO_VOICE_ID=

# ── Voice / Whisper Transcription ─────────────────────────────────────────
# Groq key above also unlocks Whisper large-v3-turbo transcription (free tier).
# OpenAI key is an optional Whisper fallback if Groq is not configured.
OPENAI_API_KEY=
